#!/usr/bin/env bash
# Entry point for both modes. The plugin does one of two jobs per step:
#
#   check   -- fail a PR that changes a package without adding a changeset
#   upload  -- on the default branch, work out whether this build opens the
#              version PR or releases, and upload the steps for it
#   version -- open or update the "Version Packages" PR
#   release -- publish or stage, then create the GitHub release
#
# version and release are normally generated by `upload` rather than written by
# hand, but they are accepted directly so a pipeline can drive either half
# itself.
#
# The split exists because Buildkite has no equivalent of GitHub's
# `on: push: branches: [main]`, so the filtering has to happen somewhere.
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PLUGIN_DIR

MODE="${BUILDKITE_PLUGIN_CHANGESETS_MODE:?mode is required (check or upload)}"

case "$MODE" in
  check)
    exec "$PLUGIN_DIR/lib/mode-check.sh"
    ;;
  upload)
    exec "$PLUGIN_DIR/lib/mode-upload.sh"
    ;;
  version)
    exec "$PLUGIN_DIR/lib/version.sh"
    ;;
  release)
    exec "$PLUGIN_DIR/lib/publish.sh"
    ;;
  *)
    echo "Unknown mode '$MODE'. Expected 'check' or 'upload'." >&2
    exit 1
    ;;
esac
